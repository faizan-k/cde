bottom:0px;padding-left:0px;}<\/style>\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-3873_f88e3a-63\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_checkCircle kt-svg-icon-list-single\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"  aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"\/><polyline points=\"22 4 12 14.01 9 11.01\"\/><\/svg><\/span><span class=\"kt-svg-icon-list-text\">Evaluation of load capacity for proposed modifications<\/span><\/li>\n\n\n<style>.kt-svg-icon-list-item-3873_8fb6be-6e .kt-svg-icon-list-text mark.kt-highlight{background-color:unset;font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}<\/style>\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-3873_8fb6be-6e\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_checkCircle kt-svg-icon-list-single\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"  aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"\/><polyline points=\"22 4 12 14.01 9 11.01\"\/><\/svg><\/span><span class=\"kt-svg-icon-list-text\">Analysis of impact of additional steel roof structure<\/span><\/li>\n\n\n<style>.kt-svg-icon-list-item-3873_0b7e3b-37 .kt-svg-icon-list-text mark.kt-highlight{background-color:unset;font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}<\/style>\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-3873_0b7e3b-37\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_checkCircle kt-svg-icon-list-single\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"  aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"\/><polyline points=\"22 4 12 14.01 9 11.01\"\/><\/svg><\/span><span class=\"kt-svg-icon-list-text\">Design of strengthening measures<\/span><\/li>\n\n\n<style>.kt-svg-icon-list-item-3873_a14c43-45 .kt-svg-icon-list-text mark.kt-highlight{background-color:unset;font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}<\/style>\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-3873_a14c43-45\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_checkCircle kt-svg-icon-list-single\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"  aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"\/><polyline points=\"22 4 12 14.01 9 11.01\"\/><\/svg><\/span><span class=\"kt-svg-icon-list-text\">Preparation of structural design solutions for modifications<\/span><\/li>\n<\/ul><\/div>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Our Approach<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">CDE carried out a detailed structural evaluation combining review of existing drawings and analytical modelling.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The assessment focused on understanding the interaction between existing structural elements and proposed modifications. Structural analysis was performed to evaluate load transfer mechanisms and identify areas requiring strengthening.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Design solutions were developed to ensure compatibility between new and existing structural systems while maintaining overall structural integrity.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Key Findings<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">The introduction of a new steel roof and additional architectural elements significantly increased loading on the existing structure.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Critical areas identified included slab sections subjected to punching shear, beams affected by demolition and modification works, and zones requiring additional support for new structural elements.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The existing structure required localized strengthening to safely accommodate the proposed changes.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Solutions &amp; Recommendations<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">CDE developed a comprehensive strengthening design to integrate new architectural features while maintaining structural integrity.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Strengthening measures included reinforcement of slabs to resist punching shear, strengthening of beams affected by modifications, and introduction of new beams and supports where required.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Additional structural provisions were made to support new elements such as steel columns, staircase openings, and cantilever projections.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">The design ensured safe load transfer and compatibility between new and existing structural components.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Outcome<\/strong><\/h3>\n\n\n\n<p class=\"wp-block-paragraph\">The project enabled seamless integration of architectural modifications without compromising structural safety.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">Through detailed analysis and tailored strengthening design, CDE ensured that the villa could accommodate additional loads and functional enhancements while maintaining structural performance and reliability.<\/p>\n\n\n\n<h3 class=\"wp-block-heading\"><strong>Key Services Delivered<\/strong><\/h3>\n\n\n<style>.wp-block-kadence-iconlist.kt-svg-icon-list-items3873_2c766c-2d:not(.this-stops-third-party-issues){margin-top:0px;margin-bottom:0px;}.wp-block-kadence-iconlist.kt-svg-icon-list-items3873_2c766c-2d ul.kt-svg-icon-list:not(.this-prevents-issues):not(.this-stops-third-party-issues):not(.tijsloc){margin-top:0px;margin-right:0px;margin-bottom:var(--global-kb-spacing-sm, 1.5rem);margin-left:0px;}.wp-block-kadence-iconlist.kt-svg-icon-list-items3873_2c766c-2d ul.kt-svg-icon-list{grid-row-gap:5px;}.wp-block-kadence-iconlist.kt-svg-icon-list-items3873_2c766c-2d ul.kt-svg-icon-list .kt-svg-icon-list-item-wrap .kt-svg-icon-list-single{margin-right:10px;}.kt-svg-icon-list-items3873_2c766c-2d ul.kt-svg-icon-list .kt-svg-icon-list-level-0 .kt-svg-icon-list-single svg{font-size:20px;}<\/style>\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items3873_2c766c-2d kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><style>.kt-svg-icon-list-item-3873_616508-3b .kt-svg-icon-list-text mark.kt-highlight{background-color:unset;font-style:normal;color:#f76a0c;-webkit-box-decoration-break:clone;box-decoration-break:clone;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;}<\/style>\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-3873_616508-3b\"><span class=\"kb-svg-icon-wrap kb-svg-icon-fe_checkCircle kt-svg-icon-list-single\"><svg viewBox=\"0 0 24 24\"  fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"  aria-hidden=\"true\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"\/><polyline points=\"22 4 12 14.01 9 11.01\"\/><\/svg><\/span><span class=\"kt-svg-icon-list-text\">Load Capacity Evaluation<\/span><\/li>\n\n\n<style>.kt-svg-icon-list-item-3873_e40b33-8c .kt-svg-icon-list-text mark.kt-highlight{background-color: